Algoritmo credenciales
	usuario = "hola"
	contrasena = "chao"
	
	
	Escribir "Ingrese el usuario: "
	leer usu
	
	Escribir "Ingrese la contraseña: "
	leer contra
	
	Si usu = usuario y contra = contrasena Entonces
		Escribir "Acceso concedido :D."
	SiNo
		Escribir "Acceso denegado :<."
	Fin Si
	
	
FinAlgoritmo
